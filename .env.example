# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git.

# Neon Postgres connection string from neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Random 64-character hex string. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Random hex string used as a salt when hashing phone numbers.
# Generate with:
#   openssl rand -hex 16
PHONE_SALT=

# Idle timeout in minutes (default 20).
# Override only if you have a good reason.
IDLE_TIMEOUT_MINUTES=20

# Set to "true" to allow new signups. Set to "false" to lock the app to
# existing accounts only.
ALLOW_SIGNUP=true
